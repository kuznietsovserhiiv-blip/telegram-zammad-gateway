# Runtime environment and application log level.
APP_ENV=production
LOG_LEVEL=INFO

# SQLite database path inside the Gateway container. Mount /data persistently.
DATABASE_URL=sqlite:////data/gateway.db

# Public URL used to register Telegram and Zammad webhooks. Use HTTPS in production.
PUBLIC_BASE_URL=http://localhost:8090

# Browser origins allowed to request a link token. Separate multiple origins with commas.
# This must include the origin that serves the /link page and sends the Zammad session cookie.
ALLOWED_ORIGINS=http://localhost:8090

# Telegram bot username (without @), Bot API token, and a random webhook secret.
TELEGRAM_BOT_USERNAME=replace_me
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_WEBHOOK_SECRET=replace_me

# One-time account-link token lifetime, maximum accepted webhook payload size, Telegram file limit, and event retention period.
LINK_TOKEN_TTL_SECONDS=600
WEBHOOK_MAX_BODY_BYTES=1048576
TELEGRAM_FILE_MAX_BYTES=20971520
EVENT_RETENTION_DAYS=30

# Zammad base URL and HTTPS verification for requests sent by the Gateway.
ZAMMAD_BASE_URL=http://localhost:3000
ZAMMAD_VERIFY_TLS=true
ZAMMAD_REQUEST_TIMEOUT_SECONDS=10

# Zammad API token, random webhook signing secret, and the service user ID used by the Gateway.
ZAMMAD_API_TOKEN=replace_me
ZAMMAD_WEBHOOK_SECRET=replace_me
ZAMMAD_SERVICE_USER_ID=0

# Numeric Zammad role IDs used to select Customer, Agent, and Admin bot workflows.
ZAMMAD_ADMIN_ROLE_ID=1
ZAMMAD_AGENT_ROLE_ID=2
ZAMMAD_CUSTOMER_ROLE_ID=3

# Host interface and port published by Docker Compose. Restrict the interface when using a reverse proxy.
GATEWAY_BIND_IP=0.0.0.0
GATEWAY_PORT=8090
